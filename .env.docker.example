# ─────────────────────────────────────────────────────────────────────────────
#  MRMS — Docker deployment configuration
#
#  This file is the single source of environment for the whole stack. Every
#  service in docker-compose.yml reads it, so a variable added here reaches the
#  containers with no compose changes.
#
#      docker compose up -d --build
#
#  Gitignored (.env* in .gitignore). Never commit it, and keep a copy of the
#  secrets somewhere safe — regenerating BETTER_AUTH_SECRET logs everyone out.
#
#  Copy to .env and fill in every value marked required:
#
#      cp .env.docker.example .env
#      docker compose up -d --build
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (runs as a container; not exposed to the host) ──────────────────
# docker-compose.yml builds DATABASE_URL from these three. Do not set
# DATABASE_URL here — the containers must reach Postgres at the hostname
# "postgres" on the compose network, not at localhost.
POSTGRES_USER=mrms
POSTGRES_PASSWORD=   # required — long random string
POSTGRES_DB=mrms

# ── Application ─────────────────────────────────────────────────────────────
# The public URL of the app. BetterAuth signs cookies and builds redirects from
# it, so a mismatch shows up as a login loop rather than an error.
NEXT_PUBLIC_APP_URL=https://care.eagleinfosolutions.com   # required
# Must be set, and must match NEXT_PUBLIC_APP_URL unless auth is genuinely
# served from another origin. Not optional: the code reads it with `??`, which
# does not treat an empty string as absent, so a blank value reaches BetterAuth
# as an empty baseURL and breaks login and PDF asset URLs.
BETTER_AUTH_URL=https://care.eagleinfosolutions.com

# Session signing key. 48 random characters.
BETTER_AUTH_SECRET=   # required — 48 random chars

# Extra origins allowed to call the auth endpoints, comma-separated. Needed if
# the app is reached on more than one hostname.
BETTER_AUTH_TRUSTED_ORIGINS=

# Platform-admin identity is decided by email alone (lib/platform-admin.ts).
PLATFORM_ADMIN_EMAIL=

APP_CURRENCY=UGX

# Host port the app is published on. The container speaks plain HTTP — put a
# TLS-terminating reverse proxy in front of it in production.
APP_PORT=3000

# ── Scheduled jobs ──────────────────────────────────────────────────────────
# The scheduler service authenticates to /api/cron/* with this. It replaces
# Vercel Cron; without it four jobs stop silently (WhatsApp retries,
# subscription lifecycle, data healing, audit pruning).
CRON_SECRET=   # required — 48 random chars

# ── Backups ─────────────────────────────────────────────────────────────────
# pg_dump into the "backups" volume. Copy dumps off the host as well: a backup
# on the same machine does not survive losing the machine.
BACKUP_INTERVAL=86400
BACKUP_KEEP_DAYS=14

# ── Queue ───────────────────────────────────────────────────────────────────
# Blank uses the bundled redis service. Only set this to point at an external
# Redis.
REDIS_URL=

# ── WhatsApp / SMS (optional) ───────────────────────────────────────────────
# Absent values disable messaging rather than breaking start-up. Per-org
# credentials in Settings → Notifications → WhatsApp override these.
WHATSAPP_PROVIDER=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_BUSINESS_NUMBER=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_WEBHOOK_APP_SECRET=

# Africa's Talking SMS fallback
AT_API_KEY=
AT_USERNAME=
AT_SENDER_ID=

# ── Email (optional) ────────────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM=
RESEND_ALERTS_FROM=
EMAIL_FROM=
REPAIR_REQUEST_ALERT_EMAIL=

# ── Payments (optional) ─────────────────────────────────────────────────────
PESAPAL_CONSUMER_KEY=
PESAPAL_CONSUMER_SECRET=
PESAPAL_ENV=

# ── AI features (optional) ──────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Public site details (optional, shown on documents and public pages) ─────
NEXT_PUBLIC_COMPANY_ADDRESS=
NEXT_PUBLIC_COMPANY_SITE_URL=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_SITE_URL=
GOOGLE_REVIEW_URL=
INVOICE_LOGO_URL=

# ── Outbox ──────────────────────────────────────────────────────────────────
OUTBOX_RETRY_LIMIT=

# ─────────────────────────────────────────────────────────────────────────────
#  Generate the three secrets on the machine that will run the stack:
#
#    openssl rand -base64 36 | tr -d '/+=' | cut -c1-40   # POSTGRES_PASSWORD
#    openssl rand -base64 48 | tr -d '/+=' | cut -c1-48   # BETTER_AUTH_SECRET
#    openssl rand -base64 48 | tr -d '/+=' | cut -c1-48   # CRON_SECRET
# ─────────────────────────────────────────────────────────────────────────────

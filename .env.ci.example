# ─────────────────────────────────────────────────────────────────────────────
#  MRMS — deploy secrets, one file
#
#  Copy this to .env.ci and fill it in. It is gitignored — never commit the
#  filled version, and keep a copy of it somewhere safe (regenerating
#  BETTER_AUTH_SECRET logs everyone out).
#
#      cp .env.ci.example .env.ci
#
#  Two different things happen with this one file, both manual, both in the
#  GitHub UI (repo → Settings → Secrets and variables → Actions):
#
#   1. The "Application" section below (everything down to the ── SSH / server
#      section) is what .github/workflows/deploy-migration-staging.yml writes
#      to `.env` on the server on every deploy. Copy that whole block —
#      exactly as it appears in your filled .env.ci, blank lines and comments
#      included, that's fine — and paste it as ONE secret named ENV_CI.
#
#   2. The five "SSH / server" values at the bottom go in individually, as
#      five separate secrets with the same names (SERVER_HOST, SERVER_USER,
#      SERVER_PORT, SERVER_SSH_KEY, DEPLOY_PATH). GitHub Actions needs them
#      as distinct secrets to plug into the SSH step directly — they can't be
#      pulled out of the ENV_CI blob at run time the way the app vars are.
#      Keeping all five in this same file just means you're copying from one
#      place instead of hunting them down separately.
#
#  Point being: everything you need to set up the deploy lives in this one
#  file. What GitHub does with each part still differs slightly, per above.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application (→ pasted as the single ENV_CI secret) ────────────────────────

# docker-compose.yml builds DATABASE_URL from these three. Do not set
# DATABASE_URL here — the containers must reach Postgres at the hostname
# "postgres" on the compose network, not at localhost.
POSTGRES_USER=mrms
POSTGRES_PASSWORD=   # required — long random string
POSTGRES_DB=mrms

# The public URL of the app. For IP:PORT testing this is http://, not https —
# there is no TLS yet, and BetterAuth reads the scheme here to decide the
# cookie's Secure flag, so https would break login over plain HTTP.
NEXT_PUBLIC_APP_URL=http://<server-ip>:3000   # required
BETTER_AUTH_URL=http://<server-ip>:3000       # required, must match the above

# Session signing key. 48 random characters.
BETTER_AUTH_SECRET=   # required — 48 random chars

# Extra origins allowed to call the auth endpoints, comma-separated. Needed if
# the app is reached on more than one hostname.
BETTER_AUTH_TRUSTED_ORIGINS=

PLATFORM_ADMIN_EMAIL=
APP_CURRENCY=UGX

# Host port the app is published on — must match the port in
# NEXT_PUBLIC_APP_URL above.
APP_PORT=3000

# Only used once a hostname exists and docker-compose.shared-edge.yml
# replaces this IP:PORT setup. Leave blank for now.
MRMS_HOSTNAME=

# The scheduler authenticates to /api/cron/* with this. Replaces Vercel Cron;
# without it four jobs stop silently (WhatsApp retries, subscription
# lifecycle, data healing, audit pruning).
CRON_SECRET=   # required — 48 random chars

BACKUP_INTERVAL=86400
BACKUP_KEEP_DAYS=14

# Blank uses the bundled redis service.
REDIS_URL=

# ── Optional: WhatsApp / SMS / email / payments / AI ──────────────────────────
# Absent values disable the feature rather than breaking start-up.
WHATSAPP_PROVIDER=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_BUSINESS_NUMBER=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_WEBHOOK_APP_SECRET=
AT_API_KEY=
AT_USERNAME=
AT_SENDER_ID=
RESEND_API_KEY=
RESEND_FROM=
RESEND_ALERTS_FROM=
EMAIL_FROM=
REPAIR_REQUEST_ALERT_EMAIL=
PESAPAL_CONSUMER_KEY=
PESAPAL_CONSUMER_SECRET=
PESAPAL_ENV=
ANTHROPIC_API_KEY=
NEXT_PUBLIC_COMPANY_ADDRESS=
NEXT_PUBLIC_COMPANY_SITE_URL=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_SITE_URL=
GOOGLE_REVIEW_URL=
INVOICE_LOGO_URL=
OUTBOX_RETRY_LIMIT=

# ── SSH / server (→ five separate secrets, same names, not part of ENV_CI) ───

# Server IP.
SERVER_HOST=
# SSH login user.
SERVER_USER=
# SSH port.
SERVER_PORT=22
# PEM private key, the whole file including the BEGIN/END lines. Paste it into
# the GitHub secret exactly as the file reads — multi-line is fine there.
SERVER_SSH_KEY=
# Path to the git clone on the server, e.g. /var/www/mrms-staging
DEPLOY_PATH=

# ─────────────────────────────────────────────────────────────────────────────
#  Generate the three application secrets on the machine that will run the
#  stack (or anywhere — they're just random strings):
#
#    openssl rand -base64 36 | tr -d '/+=' | cut -c1-40   # POSTGRES_PASSWORD
#    openssl rand -base64 48 | tr -d '/+=' | cut -c1-48   # BETTER_AUTH_SECRET
#    openssl rand -base64 48 | tr -d '/+=' | cut -c1-48   # CRON_SECRET
# ─────────────────────────────────────────────────────────────────────────────

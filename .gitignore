# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report
/test-results

# next.js
/.next/
/.next-gate/
/out/

# production
/build

# misc
.DS_Store
*.pem
.claude/worktrees/
# local-only skill (other .claude/skills/* stay tracked)
.claude/skills/agent-browser/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/app/generated/prisma

# local sqlite files
dev.db
*.db
# Generated per test run by scripts/test-schema.mjs — a copy of schema.prisma
# pointing at test.db. Regenerated every time, so committing it only creates
# churn and a second file to keep in step with the models.
prisma/schema.test.prisma
*.db-journal
*.db-wal
*.db-shm
# stray libSQL local-file artifacts (created when a command treats the Turso URL as a path)
libsql:*

# Environment values pulled down from Vercel. The .env* rule above only matches
# files whose NAME starts with .env, so a directory of *.env files slips past it.
vercel-env/
*.env
!.env.example

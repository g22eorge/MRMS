# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report
/test-results

# next.js
/.next/
# Alternate build output directories: scripts/build.mjs uses .next-gate off-CI,
# the QA scripts use .next-qa and Playwright uses .next-e2e. Globbed so a new
# one cannot get committed by accident.
.next-*/
/.next-gate/
/out/

# production
/build

# misc
.DS_Store
*.pem
.claude/worktrees/
# local-only skill (other .claude/skills/* stay tracked)
.claude/skills/agent-browser/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the committed template. `.env*` would otherwise hide it, and a
# fresh clone would have nothing to copy from.
!.env.docker.example
!.env.example
!.env.example
!.env.ci.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/app/generated/prisma

# local sqlite files
dev.db
*.db

# Database exports (bun run pg:export). Whatever the development database holds,
# which today is imported production data — never commit one.
backups/
*.dump

# The database a fresh `dev:up` restores from (bun run pg:export --setup).
# Ignored by default because it is a copy of whatever the development database
# holds — today, real clients and their phone numbers. Commit it only once the
# contents are safe for everyone who can clone this repo.
db/init/*.sql
!db/init/.gitkeep

# Generated per test run by scripts/test-schema.mjs — a copy of schema.prisma
# pointing at test.db. Regenerated every time, so committing it only creates
# churn and a second file to keep in step with the models.
prisma/schema.test.prisma
*.db-journal
*.db-wal
*.db-shm
# stray libSQL local-file artifacts (created when a command treats the Turso URL as a path)
libsql:*
.agents/
package-lock.json
prisma/dev.db.bak-before-date-fix

# `.env*` above matches by filename, so a directory of *.env files slips past it.
# vercel-env/ is a leftover of pulling values down from Vercel; deployment is
# container-based now, but the rule costs nothing and keeps stray env files out.
vercel-env/
*.env
!.env.example
!.env.docker.example

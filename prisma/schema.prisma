// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  phone         String?
  emailVerified Boolean  @default(false)
  image         String?
  role          Role     @default(OPS)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions     Session[]
  accounts     Account[]
  permissionGrants UserPermission[]
  jobsCreated  Job[]      @relation("CreatedBy")
  jobsAssigned Job[]      @relation("AssignedTo")
  payoutsMarked Job[]     @relation("PayoutMarkedBy")
  auditLogs    AuditLog[]
  clientNotes  ClientNote[]
  notifications Notification[]
  notificationPreferences NotificationPreferences?
}

model UserPermission {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission String
  createdAt  DateTime @default(now())

  @@unique([userId, permission])
  @@index([permission])
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

enum Role {
  ADMIN
  TECHNICIAN_INTERNAL
  TECHNICIAN_EXTERNAL
  OPS
  INTAKE
}

enum JobStatus {
  RECEIVED
  DIAGNOSING
  AWAITING_APPROVAL
  IN_REPAIR
  READY_FOR_PICKUP
  DELIVERED
  COMPLETED
  CLOSED
}

enum RecommendationOption {
  PROCEED_REPAIR
  REPLACE_DEVICE
  RETURN_UNREPAIRED
}

enum CommunicationStatus {
  NONE
  AWAITING_RESPONSE
  APPROVED
  DECLINED
}

enum RepairPath {
  IN_HOUSE
  EXTERNAL
}

enum DeliveryMethod {
  PICKUP
  DELIVERY
  COURIER
}

enum DeviceType {
  PHONE_ANDROID
  PHONE_IPHONE
  TABLET
  WINDOWS_PC
  MAC
  OTHER
}

enum TimelineConfidence {
  FIRM
  ESTIMATED
  PARTS_DEPENDENT
}

enum WorkflowReason {
  NONE
  PARTS_PENDING
  SPECIALIST_ESCALATION
  CLIENT_DECLINED
  UNREPAIRABLE
  CUSTOMER_CANCELLED
  OTHER
}

model Client {
  id           String   @id @default(cuid())
  fullName     String
  phone        String   @unique
  email        String?
  organization String?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  jobs         Job[]
  notesEntries ClientNote[]
}

model ClientNote {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  body      String
  createdAt DateTime @default(now())
}

model Job {
  id            String     @id @default(cuid())
  jobNumber     String     @unique
  status        JobStatus  @default(RECEIVED)
  repairPath    RepairPath?
  clientId      String
  client        Client     @relation(fields: [clientId], references: [id])
  createdById   String
  createdBy     User       @relation("CreatedBy", fields: [createdById], references: [id])
  assignedToId  String?
  assignedTo    User?      @relation("AssignedTo", fields: [assignedToId], references: [id])
  deviceType    DeviceType
  brand         String
  model         String
  serialOrImei  String?
  accessories   String?
  physicalNotes String?

  issueDescription  String
  workflowReason    WorkflowReason @default(NONE)
  statusNote        String?
  diagnosisNotes    String?
  externalDiagnosis String?
  recommendedRepair String?
  recommendationOption RecommendationOption?
  communicationStatus CommunicationStatus @default(NONE)
  clientConversationNote String?
  lastClientContactAt DateTime?
  partsNeeded       String?

  externalTechBill Float? @map("costEstimate")
  clientBill       Float? @map("finalCost")
  vatApplicable    Boolean @default(true)
  externalTechFee Float?
  externalPaid    Boolean   @default(false)
  externalPaidAt  DateTime?
  externalPaidById String?
  externalPaidBy  User?     @relation("PayoutMarkedBy", fields: [externalPaidById], references: [id])
  externalPaymentRef String?
  clientApproved Boolean?
  approvalDate   DateTime?
  quotedAt       DateTime?

  repairTimeline  String?
  timelineMinMinutes Int?
  timelineMaxMinutes Int?
  timelineConfidence TimelineConfidence?
  timelineNote String?
  technicianNotes String?
  workDone        String?
  partsReplaced   String?

  receivedAt  DateTime  @default(now())
  completedAt DateTime?
  deliveredAt DateTime?
  deliveryMethod DeliveryMethod? // PICKUP, DELIVERY, COURIER
  deliveredTo String? // name of person who received
  closedAt    DateTime?
  updatedAt   DateTime  @updatedAt

  photos    Photo[]
  auditLogs AuditLog[]
  notifications Notification[]
}

model Photo {
  id         String   @id @default(cuid())
  jobId       String
  job         Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  url         String
  label       String?
  uploadedAt DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  jobId     String
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  action    String
  detail    String?
  createdAt DateTime @default(now())
}

enum NotificationType {
  STATUS_CHANGE
  APPROVAL_NEEDED
  JOB_ASSIGNED
  ESTIMATE_SUBMITTED
  PAYMENT_RECEIVED
  PAYOUT_GENERATED
  TIMELINE_UPDATED
  DELAY_NOTE_ADDED
}

enum NotificationChannel {
  DASHBOARD
  WHATSAPP
  EMAIL
}

model Notification {
  id          String            @id @default(cuid())
  type        NotificationType
  title       String
  message     String
  jobId       String?
  job         Job?             @relation(fields: [jobId], references: [id], onDelete: SetNull)
  userId      String?
  user        User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  channel     NotificationChannel @default(DASHBOARD)
  isRead      Boolean          @default(false)
  readAt      DateTime?
  createdAt   DateTime         @default(now())
  
  @@index([userId, isRead])
  @@index([jobId])
}

model NotificationPreferences {
  id                  String   @id @default(cuid())
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  notifyStatusChange  Boolean  @default(true)
  notifyApprovalNeeded Boolean @default(true)
  notifyJobAssigned   Boolean  @default(true)
  notifyEstimateSubmitted Boolean @default(true)
  notifyPaymentReceived Boolean @default(true)
  notifyPayoutGenerated Boolean @default(true)
  notifyTimelineUpdated Boolean @default(true)
  notifyDelayNote    Boolean  @default(true)
  
  whatsappEnabled     Boolean  @default(true)
  emailEnabled        Boolean  @default(false)
  
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model DocumentBrandingSettings {
  id                   String   @id @default("singleton")
  companyName          String   @default("Eagle Info Solutions")
  companyTagline       String?
  companyAddressLine1  String   @default("Nalubega Complex, 1st Floor")
  companyAddressLine2  String   @default("Shop L28, Bombo Road Opposite Watoto Church")
  companyContacts      String   @default("+256772 006 344 | +256754 006 344")
  companyEmail         String?
  companyWebsite       String?
  documentTitle        String   @default("Job Card")
  quotePrefix          String   @default("EIS")
  quoteFormat          String   @default("{PREFIX} {M}/{YYYY}/{SEQ}")
  quoteValidityDays    Int      @default(30)
  sequencePadLength    Int      @default(4)
  vatDefaultApplicable Boolean  @default(true)
  vatRatePercent       Float    @default(18)
  vatLabel             String   @default("VAT")
  termsText            String   @default("Quotation valid for 30 days from date issued.\nRepair work begins only after approval is recorded.\nParts availability may affect final timeline.\nHidden pre-existing faults may affect final outcome.\nUncollected devices may attract storage fees after notice.")
  footerText           String   @default("System built by Almeida @ 2026 all rights reserved.")
  signatureCompanyLabel String  @default("Signed by: Eagle Info Solutions")
  signatureClientLabel String   @default("Signed by: Client")
  primaryColor         String   @default("#000000")
  secondaryColor       String   @default("#D4AF37")
  accentColor          String   @default("#D4AF37")
  backgroundColor      String   @default("#FFFFFF")
  surfaceColor         String   @default("#F5F5F5")
  borderColor          String   @default("#E5E5E5")
  updatedAt            DateTime @updatedAt
}

// REPAIR REQUEST INTAKE MODELS
model RepairRequest {
  id            String   @id @default(cuid())
  requestNumber String   @unique
  requestStatus RepairRequestStatus @default(PENDING_INTAKE)
  handoverStatus RepairHandoverStatus @default(PENDING)
  
  // Customer info
  customerName String
  phone        String
  email        String?
  preferredContactMethod ContactMethod @default(WHATSAPP)
  
  // Device info
  deviceType   DeviceType
  brand       String
  model       String?
  serialNumber String?
  
  // Problem description
  problemDescription String
  
  // Handover method specific fields
  handoverMethod    HandoverMethod
  preferredDropoffDate String?
  preferredDropoffTime String?
  dropoffNotes        String?
  
  deliveryPersonName  String?
  deliveryPersonPhone String?
  deliveryCompany     String?
  dispatchDate        String?
  expectedArrivalTime String?
  deliveryTrackingReference String?
  deliveryFeeResponsibility String?
  deliveryNotes       String?
  
  pickupAddress     String?
  pickupLandmark    String?
  preferredPickupDate String?
  preferredPickupTime String?
  alternateContactPerson String?
  alternateContactPhone String?
  pickupNotes       String?
  
  // Linked job (set when converted to a job)
  linkedJobId String?

  // Anti-spam
  submissionIp String?

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum RepairRequestStatus {
  PENDING_INTAKE
  APPROVED
  REJECTED
  CONVERTED_TO_JOB
}

enum RepairHandoverStatus {
  PENDING
  COMPLETED
  FAILED
}

enum ContactMethod {
  WHATSAPP
  PHONE
  EMAIL
  SMS
}

enum HandoverMethod {
  SELF_DROPOFF
  SEND_WITH_DELIVERY_PERSON
  REQUEST_PICKUP
}
